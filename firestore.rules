rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // User profiles - users can only read/write their own document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    
    // Email invitations collection - authenticated users can read/write
    // Note: App validates admin/owner role client-side before allowing writes
    match /artifacts/{artifactId}/public/data/mail/{mailId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated(); // App validates role client-side
    }
    
    // Dev pings collection - authenticated users can read/write
    // Note: App validates admin/owner role client-side before allowing writes
    match /artifacts/{artifactId}/public/data/devPings/{pingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated(); // App validates role client-side
    }
    
    // Generative logs collection - authenticated users can read/write
    // Note: App validates admin/owner role client-side before allowing writes
    match /artifacts/{artifactId}/public/data/generativeLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated(); // App validates role client-side
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
