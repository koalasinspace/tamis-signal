rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check user role from Firebase Auth custom claims
    // Roles are set server-side via Cloud Functions and cannot be spoofed
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }
    
    // Helper function to check if user is admin or owner
    function isAdminOrOwner() {
      return hasRole('admin') || hasRole('owner');
    }
    
    // Helper function to check if user has elevated privileges (admin, owner, or dev)
    function hasElevatedPrivileges() {
      return hasRole('admin') || hasRole('owner') || hasRole('dev');
    }
    
    // User profiles - users can only read/write their own document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    
    // Email invitations collection - server-enforced role validation
    // Only admins and owners can send invitations
    match /artifacts/{artifactId}/public/data/mail/{mailId} {
      allow read: if isAuthenticated();
      allow create: if isAdminOrOwner();
      allow update, delete: if isAdminOrOwner();
    }
    
    // Dev pings collection - server-enforced role validation
    // Any authenticated user can create (for feedback), but only elevated users can manage
    match /artifacts/{artifactId}/public/data/devPings/{pingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if hasElevatedPrivileges();
    }
    
    // Generative logs collection - server-enforced role validation
    // Any authenticated user can create logs, but only elevated users can manage
    match /artifacts/{artifactId}/public/data/generativeLogs/{logId} {
      allow read: if hasElevatedPrivileges();
      allow create: if isAuthenticated();
      allow update, delete: if hasElevatedPrivileges();
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
